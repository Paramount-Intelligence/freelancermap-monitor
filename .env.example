# Freelancermap Endpoints and Feeds
FREELANCERMAP_BASE_URL=https://www.freelancermap.com
FREELANCERMAP_PROJECTS_URL=https://www.freelancermap.com/projects
FREELANCERMAP_LOGIN_URL=https://www.freelancermap.com/login
FREELANCERMAP_ACCOUNT_URL=https://www.freelancermap.com/my_account.html
FREELANCERMAP_REQUIRE_LOGIN=true

# Dual-Feed Discovery Configuration
# The PRIMARY feed must be newest-first: it MUST contain sort=1 ("Newest
# projects first"); the monitor refuses to silently scan any other ordering.
# sort=2 is "Relevant first" and is supported for the PERSONALIZED feed.
FREELANCERMAP_PRIMARY_SEARCH_URL=https://www.freelancermap.com/projects?excludeDachProjects=false&query=your+keyword&sort=1&pagenr=1
FREELANCERMAP_PERSONALIZED_SEARCH_URL=https://www.freelancermap.com/projects?excludeDachProjects=false&query=second+keyword&sort=2&pagenr=1
ENABLE_PERSONALIZED_FEED=true
PERSONALIZED_FEED_DISCOVERY=false
# When true, a failed personalized feed fails the whole cycle instead of
# degrading gracefully.
PERSONALIZED_FEED_REQUIRED=false

# Sort verification: the parameter name and the newest-first value the
# monitor requires in the final listing URL and rendered DOM state.
FREELANCERMAP_PRIMARY_FEED_SORT_PARAM=sort
FREELANCERMAP_PRIMARY_FEED_NEWEST_SORT_VALUE=1

# Optional credential login. Interactive login (--interactive-login) is preferred.
# NEVER commit real credentials; keep them only in your local .env (gitignored).
FREELANCERMAP_LOGIN_EMAIL=
FREELANCERMAP_LOGIN_PASSWORD=

# Storage and Profile
DATA_DIR=data
CHROME_PROFILE_DIR=data/chrome_profile
CHROME_PROFILE_NAME=Default

# Browser and scan behavior
HEADLESS=true
TIMEZONE=Asia/Karachi
CHECK_INTERVAL_SECONDS=600
MAX_PAGES=1
MAX_SCROLLS_PER_PAGE=3
MAX_LOAD_MORE_CLICKS=3
MAX_PROJECTS_PER_CYCLE=40
MAX_DETAIL_PAGES_PER_CYCLE=30
DETAIL_MAX_ATTEMPTS=5
REQUEST_DELAY_MIN_SECONDS=4
REQUEST_DELAY_MAX_SECONDS=8
PAGE_LOAD_TIMEOUT=45
ELEMENT_WAIT_SECONDS=20
# A listing is only parsed once its project-route count, document height,
# loading indicators, and load-more state are unchanged for this many
# consecutive polling rounds.
LISTING_STABLE_ROUNDS=2
LISTING_STABILITY_POLL_SECONDS=0.5
SCROLL_PAUSE_SECONDS=2.0
# Raw HTML compression in SQLite. Set to false when disk space is scarce.
STORE_RAW_HTML=false
# First run on an empty database refuses to scan until an explicit baseline is
# created with: python main.py --initialize-baseline --visible
AUTO_BASELINE_ON_FIRST_RUN=false

# Chrome hardening flags. Only enable for constrained Linux/container
# deployments where Chrome cannot run sandboxed:
#   CHROME_NO_SANDBOX=true
CHROME_NO_SANDBOX=false
# Only for constrained Linux/container deployments lacking /dev/shm:
#   CHROME_DISABLE_DEV_SHM_USAGE=true
CHROME_DISABLE_DEV_SHM_USAGE=false

# Failure diagnostics (page snapshots, HTML, screenshots) written on errors.
DIAGNOSTICS_ENABLED=true
DIAGNOSTICS_DIR=data/diagnostics
DIAGNOSTIC_CAPTURE_HTML=false
DIAGNOSTIC_CAPTURE_SCREENSHOT=false
DIAGNOSTIC_REDACT_SENSITIVE_DATA=true
DIAGNOSTIC_MAX_HTML_BYTES=5000000

# SMTP — use a Google App Password if 2FA is enabled
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Freelancermap Monitor
SMTP_TO_EMAILS=your-email@gmail.com
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true

# Operational alerts: empty-scan and error emails are sent to a separate
# list, while project digests go to SMTP_TO_EMAILS.
OPERATIONAL_ALERTS_ENABLED=false
SMTP_ERROR_TO_EMAILS=
